{
  "name": "pixel-swarm",
  "version": "1.0.0",
  "description": "Pixel Swarm — a cute casual pixel-art puzzle game: send bugs out of the Art-Tree to eat pixel pictures color by color.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/pixi.js/dist/pixi.min.js','js/vendor/pixi.min.js')\"",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "preview": "node scripts/dev-server.mjs dist",
    "package:itch": "node scripts/build.mjs && node scripts/package-itch.mjs",
    "android:sync": "node scripts/build.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "android:sync:debug": "node scripts/build.mjs --debug && npx cap sync android",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [
    "html5",
    "game",
    "puzzle",
    "pixel-art",
    "capacitor"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
